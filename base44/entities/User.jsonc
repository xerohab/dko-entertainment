{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "editor",
        "user"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string",
      "description": "Public display name"
    },
    "avatar": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "motto": {
      "type": "string",
      "description": "Personal motto or bio tagline"
    },
    "bio": {
      "type": "string",
      "description": "Short biography"
    },
    "twitter_handle": {
      "type": "string",
      "description": "Twitter/X handle without @"
    }
  },
  "required": [
    "display_name",
    "avatar",
    "motto",
    "bio",
    "twitter_handle"
  ]
}