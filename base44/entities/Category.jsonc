{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category display name"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for category"
    },
    "color": {
      "type": "string",
      "default": "#CC0000",
      "description": "Badge color"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug"
  ]
}