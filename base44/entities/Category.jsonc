{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category display name"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for category"
    },
    "color": {
      "type": "string",
      "default": "#CC0000",
      "description": "Badge color"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "parent_id": {
      "type": "string",
      "description": "Parent category ID (null = top level)"
    },
    "level": {
      "type": "number",
      "default": 0,
      "description": "0=top level, 1=sub, 2=sub-sub"
    },
    "description": {
      "type": "string",
      "description": "Optional short description"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}